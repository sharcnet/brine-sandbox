{
  "extends": "default",
  "meta": {
    "name": "brine-sandbox",
    "version": "1.0.0",
    "description": "Pi against SHARCNET Brine only. The launcher fills in @KEYFILE@ and adds the filesystem grants."
  },
  "groups": {
    "include": ["node_runtime"]
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "network": {
    "allow_domain": ["nono.invalid"],
    "custom_credentials": {
      "brine": {
        "upstream": "https://brine.sharcnet.ca/v1",
        "credential_key": "file://@KEYFILE@",
        "env_var": "BRINE_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "endpoint_rules": [
          { "method": "POST", "path": "/chat/completions" },
          { "method": "GET", "path": "/models" }
        ]
      }
    },
    "credentials": ["brine"]
  },
  "workdir": {
    "access": "readwrite"
  }
}
